CONFIG_ENV=Profiles/a13ve_oneui17.env

DEVICE_NAME=samsung_SM-A137F
DEVICE_CODENAME=a13ve

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS:LD=ld.lld LLVM=1 LLVM_IAS=1

KERNEL_SOURCE=https://github.com/AlfCraft07/android_kernel_samsung_mt6768-k419.git
KERNEL_BRANCH=legion-mt6768

CLANG_SOURCE=
CLANG_BRANCH=

GCC_GNU=false
GCC_64_SOURCE=
GCC_64_BRANCH=
GCC_32_SOURCE=
GCC_32_BRANCH=

DEFCONFIG_SOURCE=
DEFCONFIG_NAME=a13ve_defconfig

KERNELSU_SOURCE=https://github.com/SukiSU-Nova/SukiSU-Nova.git
KERNELSU_BRANCH=builtin
KERNELSU_COMMIT=4bec532dd447e2852aa8932afa768255350c103a
KERNELSU_NAME=SukiSU-Nova

SUSFS_ENABLE=true
KPM_ENABLE=true
SUSFS_VERSION=v1.5.7
SUSFS_FIXED=false
SUSFS_UPDATE=false

AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

BOOT_SOURCE=

LXC_ENABLE=false

HAVE_NO_DTBO=false
HAVE_NO_DTBO_TOOL=false

ROM_TEXT=oneui17
