CONFIG_ENV=Profiles/a13ve_oneui17.env

DEVICE_NAME=samsung_SM-A137F
DEVICE_CODENAME=a13ve

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS:LD=ld.lld LLVM=1 LLVM_IAS=1

KERNEL_SOURCE=https://github.com/AlfCraft07/android_kernel_samsung_mt6768-k419.git
KERNEL_BRANCH=legion-mt6768

CLANG_SOURCE=
CLANG_BRANCH=

GCC_GNU=false
GCC_64_SOURCE=
GCC_64_BRANCH=
GCC_32_SOURCE=
GCC_32_BRANCH=

DEFCONFIG_SOURCE=
DEFCONFIG_NAME=a13ve_defconfig

KERNELSU_SOURCE=https://github.com/wshamroukh/KernelSU-Next-SUSFS-kernelv4.19.git
KERNELSU_BRANCH=ksun-v3.4.0-legacy-susfs-v2.3.0
KERNELSU_COMMIT=e821d0f6f4ca5fb35b18066764e538a5f336e2d8
KERNELSU_NAME=KernelSU-Next
KERNELSU_MANAGER_PACKAGE=com.rifsxd.ksunext

SUSFS_ENABLE=true
SUSFS_VERSION=v2.4.0
SUSFS_FIXED=false
SUSFS_UPDATE=false

KPM_ENABLE=true
KPM_SOURCE=https://github.com/KernelSU-Next/KPatch-Next-Module.git
KPM_METHOD=KPatch-Next

AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

BOOT_SOURCE=

LXC_ENABLE=false

HAVE_NO_DTBO=false
HAVE_NO_DTBO_TOOL=false

ROM_TEXT=oneui17
